\@writefile{toc}{\contentsline {paragraph}{A local Schur complement on a strip.}{10}{section*.26}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {13}{\ignorespaces Inner solve of $\mathbf  {S}$ preconditioned by $\mathbf  {K}_{FF} = \mathbf  {P}\mathbf  {K}_{\mathrm  {ref}}\mathbf  {P}$, against no preconditioner and the family FFT. (a) Spectra at $N = 128$: $\mathbf  {K}_{FF}$ lifts the bottom of the spectrum to 1 but leaves the $1/h$ spread. (b) Condition numbers. (c) Inner PCG steps per outer iteration.}}{11}{figure.13}\protected@file@percent }
\newlabel{fig:kff}{{13}{11}{Inner solve of $\mathbf {S}$ preconditioned by $\mathbf {K}_{FF} = \mathbf {P}\mathbf {K}_{\mathrm {ref}}\mathbf {P}$, against no preconditioner and the family FFT. (a) Spectra at $N = 128$: $\mathbf {K}_{FF}$ lifts the bottom of the spectrum to 1 but leaves the $1/h$ spread. (b) Condition numbers. (c) Inner PCG steps per outer iteration}{figure.13}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {14}{\ignorespaces Inner solve of $\mathbf  {S}$ preconditioned by the local Schur complement on a strip of width $w$ (balanced on the translations). (a) Fixed width in pixels. (b) Fixed physical width $w/N$. (c) Inner PCG steps.}}{11}{figure.14}\protected@file@percent }
\newlabel{fig:strip}{{14}{11}{Inner solve of $\mathbf {S}$ preconditioned by the local Schur complement on a strip of width $w$ (balanced on the translations). (a) Fixed width in pixels. (b) Fixed physical width $w/N$. (c) Inner PCG steps}{figure.14}{}}
