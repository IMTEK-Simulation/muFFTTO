\@writefile{lof}{\contentsline {figure}{\numberline {7}{\ignorespaces 3D fixed sets. Left: the cantilever's clamp plane continued through the void over the whole cell; one family, exact 2D FFT. Right: a cube clamped on all faces: three families of two parallel planes, inner PCG.}}{7}{figure.7}\protected@file@percent }
\newlabel{fig:planes3d}{{7}{7}{3D fixed sets. Left: the cantilever's clamp plane continued through the void over the whole cell; one family, exact 2D FFT. Right: a cube clamped on all faces: three families of two parallel planes, inner PCG}{figure.7}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {8}{\ignorespaces 3D cantilever with the clamp plane inverted by a 2D FFT. Left: outer CG iterations, plain against corrected Green. Right: total Green applications of the corrected Green for each solve of $\mathbf  {S}$.}}{7}{figure.8}\protected@file@percent }
\newlabel{fig:plane3d}{{8}{7}{3D cantilever with the clamp plane inverted by a 2D FFT. Left: outer CG iterations, plain against corrected Green. Right: total Green applications of the corrected Green for each solve of $\mathbf {S}$}{figure.8}{}}
\@writefile{toc}{\contentsline {paragraph}{3D: cube clamped on all six faces}{8}{section*.21}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {9}{\ignorespaces Cube clamped on all six faces. Left: outer CG iterations; the corrected Green (any solve of $\mathbf  {S}$) stays at 34, the family FFT applied once without iterating does not. Middle: total Green applications. Right: inner steps per outer iteration, plain inner CG against inner PCG with the family 2D FFTs.}}{8}{figure.9}\protected@file@percent }
\newlabel{fig:box3d}{{9}{8}{Cube clamped on all six faces. Left: outer CG iterations; the corrected Green (any solve of $\mathbf {S}$) stays at 34, the family FFT applied once without iterating does not. Middle: total Green applications. Right: inner steps per outer iteration, plain inner CG against inner PCG with the family 2D FFTs}{figure.9}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {10}{\ignorespaces Cube clamped on all six faces, $N = 32$: the displacement on three cuts (magnified; the clamped faces do not move), and the outer CG convergence. The inner-PCG curve lies on the dense-$\mathbf  {S}$ curve.}}{8}{figure.10}\protected@file@percent }
\newlabel{fig:box3ddef}{{10}{8}{Cube clamped on all six faces, $N = 32$: the displacement on three cuts (magnified; the clamped faces do not move), and the outer CG convergence. The inner-PCG curve lies on the dense-$\mathbf {S}$ curve}{figure.10}{}}
\@writefile{toc}{\contentsline {paragraph}{Removing the crossing nodes does not decouple perpendicular lines.}{9}{section*.22}\protected@file@percent }
\@writefile{toc}{\contentsline {paragraph}{Second level on the crossing patches.}{9}{section*.23}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {11}{\ignorespaces Second level on the crossing patches. (a) Sketch: the two families inverted by 1D FFTs, the patches around the crossings by a small dense solve. (b) Sorted eigenvalues of $\mathbf  {C}^{-1}\mathbf  {S}$ at $N = 128$: the family preconditioner leaves a few small eigenvalues (the corner modes) and $\lambda _{\max } = 2$; the balancing second level removes both ends. (c) cond($\mathbf  {C}^{-1}\mathbf  {S}$) against the mesh.}}{9}{figure.11}\protected@file@percent }
\newlabel{fig:patchspec}{{11}{9}{Second level on the crossing patches. (a) Sketch: the two families inverted by 1D FFTs, the patches around the crossings by a small dense solve. (b) Sorted eigenvalues of $\mathbf {C}^{-1}\mathbf {S}$ at $N = 128$: the family preconditioner leaves a few small eigenvalues (the corner modes) and $\lambda _{\max } = 2$; the balancing second level removes both ends. (c) cond($\mathbf {C}^{-1}\mathbf {S}$) against the mesh}{figure.11}{}}
