\@writefile{lof}{\contentsline {figure}{\numberline {12}{\ignorespaces Inner PCG steps per outer iteration and total Green applications (including the assembly of the patch block) for the family preconditioner alone, with additive and with balancing patches of $\pm k$ nodes.}}{10}{figure.12}\protected@file@percent }
\newlabel{fig:patchcost}{{12}{10}{Inner PCG steps per outer iteration and total Green applications (including the assembly of the patch block) for the family preconditioner alone, with additive and with balancing patches of $\pm k$ nodes}{figure.12}{}}
