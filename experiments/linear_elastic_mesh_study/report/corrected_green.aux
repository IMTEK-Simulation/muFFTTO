\newlabel{fig:size}{{1}{4}{Dense capacitance system for an $N^3$ cube with $1,\dots ,6$ clamped faces: size $m$, memory $8m^2$, factorization $m^3/3$}{figure.1}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {2}{\ignorespaces One application $\mathbf  {z} = \mathbf  {M}_{\mathrm  {GD}}\mathbf  {r}$ of the corrected Green. Blue: operations on the whole grid, orange: operations on the fixed dofs only. With a full clamped plane the orange part costs nothing compared to the blue one.}}{4}{figure.2}\protected@file@percent }
\newlabel{fig:flow}{{2}{4}{One application $\mathbf {z} = \mathbf {M}_{\mathrm {GD}}\mathbf {r}$ of the corrected Green. Blue: operations on the whole grid, orange: operations on the fixed dofs only. With a full clamped plane the orange part costs nothing compared to the blue one}{figure.2}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {3}{\ignorespaces Inexact inner solve of $\mathbf  {S}$ (2D cantilever with holes). Outer CG iterations against the inner tolerance and against a fixed number of inner steps; total Green applications of the cheapest variant that keeps the direct outer count; compliance error. Open markers: no convergence within 5000 outer iterations.}}{4}{figure.3}\protected@file@percent }
\newlabel{fig:inexact}{{3}{4}{Inexact inner solve of $\mathbf {S}$ (2D cantilever with holes). Outer CG iterations against the inner tolerance and against a fixed number of inner steps; total Green applications of the cheapest variant that keeps the direct outer count; compliance error. Open markers: no convergence within 5000 outer iterations}{figure.3}{}}
\@writefile{toc}{\contentsline {paragraph}{Full grid planes: $\mathbf  {S}$ is block-circulant.}{4}{section*.18}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {4}{\ignorespaces Fixed sets on a periodic grid and the solve of $\mathbf  {S}$ they allow. (a) A clamp on the solid face only: $\mathbf  {S}$ is not circulant. (b) The same clamp continued through the void over the whole periodic cell: the void has zero stiffness, so the problem does not change, but $\mathbf  {S}$ becomes block-circulant and is inverted exactly by an FFT along the line. (c) Parallel full lines: still exact. (d) Perpendicular lines: two families; inner PCG with each family inverted by its FFT, the crossing nodes in both.}}{5}{figure.4}\protected@file@percent }
\newlabel{fig:sets}{{4}{5}{Fixed sets on a periodic grid and the solve of $\mathbf {S}$ they allow. (a) A clamp on the solid face only: $\mathbf {S}$ is not circulant. (b) The same clamp continued through the void over the whole periodic cell: the void has zero stiffness, so the problem does not change, but $\mathbf {S}$ becomes block-circulant and is inverted exactly by an FFT along the line. (c) Parallel full lines: still exact. (d) Perpendicular lines: two families; inner PCG with each family inverted by its FFT, the crossing nodes in both}{figure.4}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {5}{\ignorespaces The wall FFT on real data (one full clamp line, isotropic reference). Left: the kernel of $\mathbf  {S}$, the response along the line to a unit force at one line node (32, 64, 128 nodes on the line collapse). Right: the eigenvalues of its $2\times 2$ symbol per wave number decay like $1/\xi $, hence $\operatorname  {cond}\mathbf  {S}\sim 1/h$ and the growth of plain inner CG; inverting the symbol block by block is exact for every $\xi $.}}{5}{figure.5}\protected@file@percent }
\newlabel{fig:symbol}{{5}{5}{The wall FFT on real data (one full clamp line, isotropic reference). Left: the kernel of $\mathbf {S}$, the response along the line to a unit force at one line node (32, 64, 128 nodes on the line collapse). Right: the eigenvalues of its $2\times 2$ symbol per wave number decay like $1/\xi $, hence $\operatorname {cond}\mathbf {S}\sim 1/h$ and the growth of plain inner CG; inverting the symbol block by block is exact for every $\xi $}{figure.5}{}}
\@writefile{toc}{\contentsline {paragraph}{Perpendicular planes (all faces of a box).}{6}{section*.19}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {6}{\ignorespaces 2D square with holes, fixed full lines through the void. Left: two parallel lines, total cost; the FFT solve is exact and costs 68 Green applications on every mesh. Middle and right: all four faces; inner PCG with the family FFT blocks needs 10--13 inner steps, against 32--75 for plain inner CG.}}{6}{figure.6}\protected@file@percent }
\newlabel{fig:box2d}{{6}{6}{2D square with holes, fixed full lines through the void. Left: two parallel lines, total cost; the FFT solve is exact and costs 68 Green applications on every mesh. Middle and right: all four faces; inner PCG with the family FFT blocks needs 10--13 inner steps, against 32--75 for plain inner CG}{figure.6}{}}
