\@writefile{lof}{\contentsline {figure}{\numberline {1}{\ignorespaces The periodic cell at $n_H = 4$: void pixels (white), beam (yellow), clamped nodes (black squares) and the shear load on the right face (red).}}{2}{figure.caption.1}\protected@file@percent }
\providecommand*\caption@xref[2]{\@setref\relax\@undefined{#1}}
\newlabel{fig:setup}{{1}{2}{The periodic cell at $n_H = 4$: void pixels (white), beam (yellow), clamped nodes (black squares) and the shear load on the right face (red)}{figure.caption.1}{}}
\@writefile{toc}{\contentsline {section}{\numberline {2}What we saw: a long stall, then fast convergence}{2}{section.2}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {2}{\ignorespaces Left: exact CG error (solid), the stopping estimate (dotted) and the discretisation error of each mesh (dashed). Middle: the residual, which first grows by about $100\times $ and is useless as a stopping test here. Right: estimate divided by exact error. Once CG converges, the estimate is within 1--6\,\% of the exact error. During the stall it badly underestimates, which would matter for a loose tolerance.}}{2}{figure.caption.4}\protected@file@percent }
\newlabel{fig:cg}{{2}{2}{Left: exact CG error (solid), the stopping estimate (dotted) and the discretisation error of each mesh (dashed). Middle: the residual, which first grows by about $100\times $ and is useless as a stopping test here. Right: estimate divided by exact error. Once CG converges, the estimate is within 1--6\,\% of the exact error. During the stall it badly underestimates, which would matter for a loose tolerance}{figure.caption.4}{}}
\@writefile{toc}{\contentsline {section}{\numberline {3}The stall follows the beam length, not the fixed nodes}{2}{section.3}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {3}{\ignorespaces Exact CG error at $n_H = 64$. Only panel A (the beam length) moves the stall substantially. In panel D all four load positions stall until about iteration 270.}}{3}{figure.caption.5}\protected@file@percent }
\newlabel{fig:plateau}{{3}{3}{Exact CG error at $n_H = 64$. Only panel A (the beam length) moves the stall substantially. In panel D all four load positions stall until about iteration 270}{figure.caption.5}{}}
\@writefile{toc}{\contentsline {section}{\numberline {4}The spectrum behind it}{3}{section.4}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {4}{\ignorespaces All eigenvalues from a dense computation (grey) and the Ritz values from the CG run (blue). The zero eigenvalues of nodes that touch only void, and of fixed nodes, are left out.}}{3}{figure.caption.6}\protected@file@percent }
\newlabel{fig:dense}{{4}{3}{All eigenvalues from a dense computation (grey) and the Ritz values from the CG run (blue). The zero eigenvalues of nodes that touch only void, and of fixed nodes, are left out}{figure.caption.6}{}}
\@writefile{lot}{\contentsline {table}{\numberline {1}{\ignorespaces Clamped cantilever with 2 void pixels: CG iterations and the extreme eigenvalues of $M^{-1}K$.}}{3}{table.caption.8}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {5}{\ignorespaces With 2 void pixels: the smallest eigenvalue falls like $h^3$ and the largest grows like $1/h$, so the condition number grows like $h^{-4}$. CG still does much better than $\sqrt  {\kappa }$ would suggest, because the very small eigenvalues are few and isolated; the stall is CG finding them one at a time. Right: the number of eigenvalues below 0.05 doubles each time the beam length doubles (2, 4, 7, 14).}}{4}{figure.caption.7}\protected@file@percent }
\newlabel{fig:spectrum}{{5}{4}{With 2 void pixels: the smallest eigenvalue falls like $h^3$ and the largest grows like $1/h$, so the condition number grows like $h^{-4}$. CG still does much better than $\sqrt {\kappa }$ would suggest, because the very small eigenvalues are few and isolated; the stall is CG finding them one at a time. Right: the number of eigenvalues below 0.05 doubles each time the beam length doubles (2, 4, 7, 14)}{figure.caption.7}{}}
\@writefile{toc}{\contentsline {section}{\numberline {5}Fix 1: give the void a fixed physical thickness}{4}{section.5}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {6}{\ignorespaces Fixed physical void thickness $t$ against 2 void pixels (dashed). Second panel: $\lambda _{\min }$ is flat in $h$ for every fixed $t$. Right: the tip deflection differs by $10^{-11}$ between void thicknesses.}}{4}{figure.caption.9}\protected@file@percent }
\newlabel{fig:void}{{6}{4}{Fixed physical void thickness $t$ against 2 void pixels (dashed). Second panel: $\lambda _{\min }$ is flat in $h$ for every fixed $t$. Right: the tip deflection differs by $10^{-11}$ between void thicknesses}{figure.caption.9}{}}
